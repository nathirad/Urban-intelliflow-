# Copy to .env and fill in. Never commit .env (PDPA / ISO 27001).

# Edge / MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Gemini 1.5 Flash (VLLM) — incident narration + complaint classification
GEMINI_API_KEY=

# Databases (production)
MONGO_URI=mongodb://localhost:27017/intelliflow
POSTGRES_URI=postgresql://localhost:5432/intelliflow

# Kafka (production)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=intelliflow.metrics

# OAuth / OIDC providers (production via Keycloak). Leave unset → demo sign-in.
LINE_CHANNEL_ID=
GOOGLE_CLIENT_ID=
THAIID_CLIENT_ID=
OIDC_SSO_CLIENT_ID=

# Facebook OAuth
FACEBOOK_APP_ID=

# OAuth client secrets + base URLs (set these to enable REAL provider login)
LINE_CHANNEL_SECRET=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
