# Copy to .env and fill in. Never commit .env (PDPA / ISO 27001).

# Edge / MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Gemini 1.5 Flash (VLLM) — incident narration + complaint classification
GEMINI_API_KEY=

# Databases (production)
MONGO_URI=mongodb://localhost:27017/intelliflow
POSTGRES_URI=postgresql://localhost:5432/intelliflow

# Kafka (production)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=intelliflow.metrics
